<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standalone disposable acceptance fixture; no shared production or test-project edits. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
    <AssemblyName>Client.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Server/Services/UserService.fs" Link="Server/UserService.fs" />
    <Compile Include="EmptyServerWorkContinuityTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Client/Client.fsproj" />
  </ItemGroup>
</Project>
