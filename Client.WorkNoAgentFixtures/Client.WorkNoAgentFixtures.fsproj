<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standalone test-only compilation avoids edits to the actively shared
       Client.Tests.fsproj (Worker 1 native-launch binding is concurrent).
       AssemblyName preserves the existing fixture-only InternalsVisibleTo
       boundary; it does not enable public Work execution. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
    <AssemblyName>Client.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="WorkNoPersistentAgentLifecycleTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Client/Client.fsproj" />
  </ItemGroup>
</Project>
