<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <AssemblyName>JarvisServer</AssemblyName>
        <LangVersion>11.0</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Structure.md"/>
        <Compile Include="JarvisOptions.fs"/>
        <Compile Include="Auth.fs"/>
        <Compile Include="HttpRateLimitProtection.fs"/>
        <Compile Include="Services\ClientResponseTracker.fs"/>
        <Compile Include="Services\UserService.fs"/>
        <Compile Include="Services\ExportStore.fs"/>
        <Compile Include="Services\FeedbackStore.fs"/>
        <Compile Include="Services\HubService.fs"/>
        <Compile Include="Services\ClientService.fs"/>
        <Compile Include="McpTools.fs"/>
        <Compile Include="McpEndpoint.fs"/>
        <Compile Include="Program.fs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0"/>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0"/>
        <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.1.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Common\Common.fsproj"/>
    </ItemGroup>

</Project>
