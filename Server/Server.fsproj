<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <AssemblyName>JarvisServer</AssemblyName>
        <LangVersion>11.0</LangVersion>
        <!-- Fail compilation when a new AgentCommand is omitted from authorization dispatch. -->
        <WarningsAsErrors>FS0025</WarningsAsErrors>
    </PropertyGroup>

    <!-- WQ08's hypothetical planner is internal and callable only by the test assembly.
         The normal Planner entry point keeps WQ04 canDispatch fail-closed. -->
    <ItemGroup>
        <InternalsVisibleTo Include="Server.Tests" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Structure.md"/>
        <Compile Include="WorkQueueContracts.fs"/>
        <Compile Include="WorkSnapshotCodec.fs"/>
        <Compile Include="WorkComposition.fs"/>
        <Compile Include="WorkSqliteAuthority.fs"/>
        <Compile Include="WorkProposal.fs"/>
        <Compile Include="WorkQueueSchedulerInert.fs"/>
        <Compile Include="WorkQueueDependencyDiagnostics.fs"/>
        <Compile Include="WorkBlocking.fs"/>
        <Compile Include="WorkQueueProducers.fs"/>
        <Compile Include="WorkQueueSchedulerPrototype.fs"/>
        <Compile Include="JarvisOptions.fs"/>
        <Compile Include="Auth.fs"/>
        <Compile Include="ManualGrantStore.fs"/>
        <Compile Include="HttpRateLimitProtection.fs"/>
        <Compile Include="Services\ClientResponseTracker.fs"/>
        <Compile Include="Services\UserService.fs"/>
        <Compile Include="Services\ExportStore.fs"/>
        <Compile Include="Services\FeedbackStore.fs"/>
        <Compile Include="Services\OptionalFeedbackStore.fs"/>
        <Compile Include="Services\HubService.fs"/>
        <Compile Include="Services\ClientService.fs"/>
        <Compile Include="McpTools.fs"/>
        <Compile Include="McpEndpoint.fs"/>
        <Compile Include="Program.fs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0"/>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0"/>
        <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.1.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Common\Common.fsproj"/>
    </ItemGroup>

</Project>
