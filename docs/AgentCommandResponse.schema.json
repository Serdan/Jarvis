{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jarvis:agent-command-response",
  "title": "AgentCommandResponse",
  "description": "Client-to-server Jarvis command response. OperationalControls is the closed typed control channel. Instructions is an optional legacy compatibility projection; repository documents are ignored. State-change status distinguishes complete, unknown and pending evidence.",
  "type": "object",
  "required": [
    "Result",
    "Error"
  ],
  "properties": {
    "Result": {
      "type": [
        "string",
        "null"
      ],
      "description": "Existing serialized command result, unchanged."
    },
    "Error": {
      "type": [
        "object",
        "null"
      ],
      "description": "Existing AgentError discriminated union representation, unchanged."
    },
    "Instructions": {
      "type": [
        "array",
        "null"
      ],
      "description": "Legacy projection only. New peers prefer OperationalControls and omit Instructions when no operational controls are present; legacy documents and notices are ignored.",
      "items": {
        "$ref": "#/$defs/InstructionDocument"
      }
    },
    "AgentStateChanges": {
      "type": [
        "array",
        "null"
      ],
      "description": "Complete affected identities when confirmed. The legacy list may contain a partial subset only under UncertainOutcome, which old readers already recognize. Otherwise an unknown receipt has a null legacy list, not a complete empty set.",
      "items": {
        "$ref": "#/$defs/AgentStateChange"
      }
    },
    "InboxActivation": {
      "oneOf": [
        {
          "$ref": "#/$defs/AgentInboxActivation"
        },
        {
          "type": "null"
        }
      ],
      "description": "Explicit caller-visible result of self-AgentInbox activation; absent for other commands. Preserved on a failed inbox read after a confirmed transition."
    },
    "OperationalControls": {
      "type": [
        "array",
        "null"
      ],
      "description": "Closed operational control union, in STOP-first order. Absence falls back to legacy Instructions; an explicitly empty typed array has precedence.",
      "items": {
        "$ref": "#/$defs/OperationalControl"
      }
    },
    "AgentStateChangesStatus": {
      "enum": [
        "confirmed",
        "unknown",
        "pending"
      ],
      "description": "New peers emit explicit completeness independently of operation success or error. Missing legacy status is inferred conservatively from PendingJob, UncertainOutcome and the available receipt fields."
    },
    "KnownAgentStateChanges": {
      "type": "array",
      "description": "Independently known subset when status is unknown without UncertainOutcome. Omitted for complete or pending receipts and empty unknown subsets. Never a complete list.",
      "items": {
        "$ref": "#/$defs/AgentStateChange"
      }
    },
    "PendingJob": {
      "oneOf": [
        {
          "$ref": "#/$defs/ToolJobHandle"
        },
        {
          "type": "null"
        }
      ],
      "description": "In-flight tool operation; poll the original job on the bound device. Pending is not a terminal mutation receipt."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "InstructionDocument": {
      "type": "object",
      "required": [
        "Scope",
        "Path",
        "Sha256",
        "Content"
      ],
      "properties": {
        "Scope": {
          "type": "string",
          "description": "Recognized legacy operational scopes: response-alert and working-turn. All other scopes are ignored."
        },
        "Path": {
          "type": "string"
        },
        "Sha256": {
          "type": "string",
          "description": "Empty for operational control projections."
        },
        "Content": {
          "type": "string",
          "description": "Legacy control text or ignored repository document."
        }
      },
      "additionalProperties": false
    },
    "AgentStateChange": {
      "type": "object",
      "required": [
        "ProjectName",
        "AgentId"
      ],
      "properties": {
        "ProjectName": {
          "type": "string",
          "minLength": 1
        },
        "AgentId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "AgentInboxActivation": {
      "type": "object",
      "required": [
        "ProjectName",
        "AgentId",
        "ActivatedByThisCall",
        "BeforeState",
        "AfterState",
        "CommittedHead",
        "OperationId"
      ],
      "properties": {
        "ProjectName": {
          "type": "string",
          "minLength": 1
        },
        "AgentId": {
          "type": "string"
        },
        "ActivatedByThisCall": {
          "type": "boolean"
        },
        "BeforeState": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Ready",
            null
          ]
        },
        "AfterState": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Working",
            null
          ]
        },
        "CommittedHead": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "OperationId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "A true value must be backed by a confirmed canonical Ready-to-Working operation receipt, not inferred from the returned inbox state. False means this call did not commit an activation.",
      "additionalProperties": false
    },
    "OperationalControl": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "case",
            "level",
            "advisory"
          ],
          "properties": {
            "case": {
              "const": "WorkingTurnLimit"
            },
            "level": {
              "enum": [
                "Soft",
                "Hard"
              ]
            },
            "advisory": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "case",
            "alertId",
            "text"
          ],
          "properties": {
            "case": {
              "const": "QueuedResponseAlert"
            },
            "alertId": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "case",
            "detail"
          ],
          "properties": {
            "case": {
              "const": "ActivationUnverified"
            },
            "detail": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ToolJobHandle": {
      "type": "object",
      "required": [
        "JobId",
        "Kind",
        "Status",
        "ProjectName",
        "DeviceId",
        "AgentId",
        "OperationId",
        "CommandName",
        "StartedAt"
      ],
      "properties": {
        "JobId": {
          "type": "string"
        },
        "Kind": {
          "enum": [
            "Process",
            "ToolOperation"
          ]
        },
        "Status": {
          "type": "string"
        },
        "ProjectName": {
          "type": [
            "string",
            "null"
          ]
        },
        "DeviceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "AgentId": {
          "type": "string"
        },
        "OperationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "CommandName": {
          "type": "string"
        },
        "StartedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
