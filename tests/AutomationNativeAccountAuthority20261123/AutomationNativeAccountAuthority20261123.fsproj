<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Client.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Client/AutomationNativeAccountAuthority.fs" Link="AutomationNativeAccountAuthority.fs" />
    <Compile Include="../../Client.Tests/AccountCapacityLedgerTests.fs" Link="AccountCapacityLedgerTests.fs" />
    <Compile Include="obj/Generated.AuthorityTests.fs" />
    <ProjectReference Include="../../Client/Client.fsproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
