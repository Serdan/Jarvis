<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Client.Tests</AssemblyName>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);NATIVE_NO_SEND_ENVELOPE_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Client/Client.fsproj" />
    <Compile Include="obj/NativeProjectEffectTransition.fs" />
    <Compile Include="../../Client.Tests/NativeSchedulerRosterPolicyTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
