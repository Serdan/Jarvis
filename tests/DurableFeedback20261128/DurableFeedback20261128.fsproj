<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Server/Services/FeedbackStore.fs" Link="FeedbackStore.fs"/>
    <Compile Include="../../Server/Services/OptionalFeedbackStore.fs" Link="OptionalFeedbackStore.fs"/>
    <Compile Include="../../Server/Services/DurableFeedbackStore.fs" Link="DurableFeedbackStore.fs"/>
    <Compile Include="DurableFeedbackTests.fs"/>
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0"/>
    <PackageReference Include="NUnit" Version="4.3.2"/>
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0"/>
  </ItemGroup>
</Project>
