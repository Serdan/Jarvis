<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- Keep the SDK entry point after the F# test module so startup
         initialization is not emitted into an entry point NUnit never calls. -->
    <GenerateProgramFile>true</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Client/Client.fsproj" />
    <Compile Include="../../Client/Modules/ProviderLaunch.fs" />
    <Compile Include="../../Client/Modules/ProviderMcpProvisioning.fs" />
    <Compile Include="../../Client/Modules/ProviderLaunchAdapters.fs" />
    <Compile Include="Tests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
